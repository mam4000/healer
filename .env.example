# HEALER Environment Configuration
# Copy this file to .env and modify as needed

# ============================================================================
# Docker / Infrastructure
# ============================================================================

# Redis password used by docker-compose (change this in production)
REDIS_PASSWORD=redis_password_change_me

# Google Analytics ID (optional, leave blank to disable)
# GA_ID=G-XXXXXXXXXX

# ============================================================================
# Server Mode
# ============================================================================

# Enable server mode (Cloud Tasks/Redis for async job processing)
# Set to 'true' for production deployments, 'false' for local/simple mode
HEALER_SERVER_MODE=false

# ============================================================================
# Data Directory
# ============================================================================

# Path to your building block SDF files on the host machine.
# In Docker: this directory is bind-mounted into the container at /buildingblocks.
# Outside Docker: Python reads this path directly.
# Use the full absolute path (~ is not expanded in .env files).
# If not set, falls back to the small test set bundled with the package.
# HEALER_DATA_DIR=/home/<your-username>/.healer/buildingblocks

# ============================================================================
# Redis Configuration (only needed if HEALER_SERVER_MODE=true)
# ============================================================================

HEALER_REDIS_URL=redis://localhost:6379/0

# ============================================================================
# Server Parameter Limits
# ============================================================================
# These limits are applied when HEALER_SERVER_MODE=true to prevent
# resource exhaustion on shared servers. Adjust based on your server capacity.

# Max reaction evaluation attempts per composition
HEALER_LIMIT_MAX_EVALS=2000

# Max products to keep per composition
HEALER_LIMIT_MAX_PRODUCTS=100

# Max total products across all compositions (stops enumeration early)
HEALER_LIMIT_MAX_TOTAL=500

# Similarity threshold range for building block matching
HEALER_LIMIT_SIM_MIN=0.5
HEALER_LIMIT_SIM_MAX=1.0

# Max building blocks to consider per fragment (-1 for unlimited)
HEALER_LIMIT_MAX_BBS=10

# Max number of fragment compositions to enumerate
HEALER_LIMIT_N_COMP=10

# Max retrosynthesis tree depth (1 or 2 recommended)
HEALER_LIMIT_RETRO_DEPTH=1

# Minimum fragment size in heavy atoms (prevents tiny fragments)
HEALER_LIMIT_MIN_FRAG=7

# Max number of reaction tags that can be selected
HEALER_LIMIT_MAX_RXN_TAGS=8

# ============================================================================
# Cloud Tasks
# ============================================================================

# Redis retains job status and results for this period; it is not a queue.
HEALER_RESULT_TTL_SECONDS=7200
HEALER_GCP_PROJECT=bcquery
HEALER_TASKS_LOCATION=us-west1
HEALER_TASKS_QUEUE=healer-enumeration
HEALER_TASK_WORKER_URL=https://healer-task-worker-REPLACE.run.app
HEALER_TASK_DISPATCHER_SERVICE_ACCOUNT=healer-task-dispatcher@bcquery.iam.gserviceaccount.com
