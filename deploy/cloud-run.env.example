# Copy to deploy/cloud-run.env. It contains deployment metadata only; do not
# store credentials in this file.
PROJECT_ID=bcquery
REGION=us-west1
# Optional: Cloud Build fetches committed source directly from this Git URL.
# Leave blank to use a local source upload instead.
BUILD_SOURCE_REPOSITORY=https://github.com/mam4000/healer
BUILD_SOURCE_REVISION=main
SERVICE_NAME=healer-web
TASK_WORKER_SERVICE_NAME=healer-task-worker
REPOSITORY=healer
NETWORK=healer-vpc
SUBNET=healer-run-cloudrun
SUBNET_RANGE=10.8.1.0/26
REDIS_RANGE=10.9.0.0/29
REDIS_INSTANCE=healer-redis
REDIS_SECRET=healer-redis-url
WEB_SERVICE_ACCOUNT=healer-web
WORKER_SERVICE_ACCOUNT=healer-worker
TASK_DISPATCHER_SERVICE_ACCOUNT=healer-task-dispatcher
TASK_QUEUE=healer-enumeration
BUILDING_BLOCK_BUCKET=healer_data
BUILDING_BLOCK_PREFIX=buildingblocks
BUILDING_BLOCK_MOUNT_PATH=/mnt/healer-buildingblocks
TASK_WORKER_CPU=4
TASK_WORKER_MEMORY=8Gi
TASK_WORKER_MAX_INSTANCES=13
TASK_WORKER_TIMEOUT=900
TASK_QUEUE_MAX_CONCURRENT_DISPATCHES=13
TASK_QUEUE_MAX_DISPATCHES_PER_SECOND=13
TASK_QUEUE_MAX_ATTEMPTS=10
# IAP signed-header audience for the HEALER backend service on the shared
# external HTTPS load balancer (not the Cloud Run service audience).
IAP_JWT_AUDIENCE=/projects/PROJECT_NUMBER/global/backendServices/BACKEND_SERVICE_ID
CHEMQUERY_RUNTIME_SERVICE_ACCOUNT=chemquery-runtime@collabra-data-3.iam.gserviceaccount.com
# Existing Secret Manager secret also configured as
# HEALER_CHEMQUERY_SHARED_SECRET in ChemQuery.
CHEMQUERY_SHARED_SECRET_NAME=healer-chemquery-shared-secret
