# --- Stage 0: Frontend builder ---
FROM node:20-slim AS frontend

WORKDIR /web

COPY web_client/package.json web_client/package-lock.json ./
RUN npm ci --ignore-scripts

COPY web_client/ ./
# Override outDir so the build stays inside this stage
RUN npm run build -- --outDir /frontend-dist


# --- Stage 1: Builder ---
FROM python:3.11-slim AS builder

# Suppress debconf warnings in Docker
ENV DEBIAN_FRONTEND=noninteractive \
    DEBCONF_NONINTERACTIVE_SEEN=true

WORKDIR /build

# Install build tools and system libs required to compile Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libxrender1 \
    libxext6 \
    libexpat1 \
    libfontconfig1 \
    libfreetype6 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
COPY . .

# Replace the static dir with the freshly compiled frontend
COPY --from=frontend /frontend-dist ./healer/web/static/

# Non-editable install
RUN pip install pip --upgrade
RUN pip install --no-cache-dir ".[web]"


# --- Stage 2: Runtime ---
FROM python:3.11-slim AS runtime

# Optional build arg for Google Analytics ID
ARG GA_ID=GA_ID_PLACEHOLDER

# Suppress debconf warnings in Docker
ENV DEBIAN_FRONTEND=noninteractive \
    DEBCONF_NONINTERACTIVE_SEEN=true

WORKDIR /app

# Runtime system libs only — no compilers
RUN apt-get update && apt-get install -y --no-install-recommends \
    libxrender1 \
    libxext6 \
    libexpat1 \
    libfontconfig1 \
    libfreetype6 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy installed Python packages and console scripts from builder
COPY --from=builder /usr/local/lib /usr/local/lib
COPY --from=builder /usr/local/bin /usr/local/bin

# Inject GA tracking ID into the installed static file if provided
RUN if [ "$GA_ID" != "GA_ID_PLACEHOLDER" ]; then \
      find /usr/local/lib -name "index.html" -path "*/healer/web/static/*" \
        -exec sed -i "s/GA_ID_PLACEHOLDER/$GA_ID/g" {} \; ; \
    fi

# Create non-root user for security
RUN useradd -m -u 1000 healer

USER healer

# Cloud Run injects PORT at runtime. A single worker is intentional: enumeration
# work is CPU and memory intensive, so concurrency is handled by Celery workers.
CMD ["sh", "-c", "exec uvicorn healer.web.app:app --host 0.0.0.0 --port ${PORT:-8080} --workers 1"]
